{
  "regions": ["fra1"],
  "images": {
    "sizes": [256, 384, 640, 828],
    "qualities": [75],
    "formats": ["image/webp"],
    "minimumCacheTTL": 2678400,
    "remotePatterns": [{ "protocol": "https", "hostname": "**" }]
  },
  "crons": [{ "path": "/api/keepalive", "schedule": "0 6 * * *" }],
  "rewrites": [
    {
      "source": "/wishlist/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|Slackbot|Discordbot|TelegramBot|LinkedInBot|SkypeUriPreview|Pinterestbot|redditbot|Embedly|Iframely|Mastodon|Cardyb|vkShare|Google-PageRenderer).*"
        }
      ],
      "destination": "/api/wishlist-preview?id=:id"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ]
}
